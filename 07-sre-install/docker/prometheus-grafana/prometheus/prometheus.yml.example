# Prometheus 配置文件示例 - 包含与其他服务的联动配置
# 将此文件复制为 prometheus.yml 并根据实际情况修改

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: 'monitoring'
    replica: 'prometheus-1'

rule_files:
  - "rules/*.yml"

scrape_configs:
  # Prometheus 自身监控
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
        labels:
          instance: 'prometheus'

  # Node Exporter - 系统指标监控
  # 需要在 docker-compose.yaml 中添加 node-exporter 服务
  - job_name: 'node-exporter'
    static_configs:
      - targets: ['node-exporter:9100']
        labels:
          instance: 'node-exporter'
          job: 'system'

  # MySQL Exporter - MySQL 监控
  # 需要在 docker-compose.yaml 中添加 mysql-exporter 服务
  # 环境变量: DATA_SOURCE_NAME="user:password@(mysql-host:3306)/"
  - job_name: 'mysql-exporter'
    static_configs:
      - targets: ['mysql-exporter:9104']
        labels:
          instance: 'mysql-server'
          database: 'production'
    scrape_interval: 30s
    metrics_path: /metrics

  # cAdvisor - Docker 容器监控
  # 需要在 docker-compose.yaml 中添加 cadvisor 服务
  - job_name: 'cadvisor'
    static_configs:
      - targets: ['cadvisor:8080']
        labels:
          instance: 'cadvisor'
          job: 'docker'

  # Redis Exporter - Redis 监控
  # 需要在 docker-compose.yaml 中添加 redis-exporter 服务
  # 环境变量: REDIS_ADDR="redis://redis-host:6379"
  - job_name: 'redis-exporter'
    static_configs:
      - targets: ['redis-exporter:9121']
        labels:
          instance: 'redis-server'
          job: 'redis'

  # PostgreSQL Exporter - PostgreSQL 监控
  # 需要在 docker-compose.yaml 中添加 postgres-exporter 服务
  # 环境变量: DATA_SOURCE_NAME="postgresql://user:password@postgres-host:5432/dbname?sslmode=disable"
  - job_name: 'postgres-exporter'
    static_configs:
      - targets: ['postgres-exporter:9187']
        labels:
          instance: 'postgres-server'
          job: 'postgresql'

  # MongoDB Exporter - MongoDB 监控
  # 需要在 docker-compose.yaml 中添加 mongodb-exporter 服务
  # 环境变量: MONGODB_URI="mongodb://user:password@mongodb-host:27017"
  - job_name: 'mongodb-exporter'
    static_configs:
      - targets: ['mongodb-exporter:9216']
        labels:
          instance: 'mongodb-server'
          job: 'mongodb'

  # 监控其他 Docker 服务（如果服务暴露了 metrics 端点）
  # 示例：监控自定义应用服务
  - job_name: 'custom-app'
    static_configs:
      - targets: ['custom-app:8080']
        labels:
          instance: 'custom-app'
          job: 'application'
    metrics_path: /metrics

  # 使用服务发现监控 Docker 容器（需要 docker_sd_configs）
  # 注意：这需要 Prometheus 能够访问 Docker socket
  # - job_name: 'docker-containers'
  #   docker_sd_configs:
  #     - host: unix:///var/run/docker.sock
  #       port: 2375
  #   relabel_configs:
  #     - source_labels: [__meta_docker_container_name]
  #       regex: '/(.*)'
  #       target_label: container_name
  #     - source_labels: [__meta_docker_container_label_com_docker_compose_service]
  #       target_label: compose_service

# 告警管理器配置（需要单独部署 Alertmanager）
# alerting:
#   alertmanagers:
#     - static_configs:
#         - targets:
#           - alertmanager:9093
